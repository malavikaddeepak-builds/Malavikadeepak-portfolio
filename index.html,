<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Malavika Deepak — Sales & Marketing Professional</title>
  <meta name="description" content="Sales and Marketing professional building BDE Workspace, writing about business, growth and sales. Aspiring MBA candidate."/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #F5F0E8;
      --warm-white: #FAF7F2;
      --sand: #E8DFD0;
      --tan: #C9B99A;
      --brown: #8B6F47;
      --dark: #2C1810;
      --text: #3D2B1F;
      --muted: #7A6152;
    }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--cream);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      overflow-x: hidden;
    }

    /* Grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 999;
      opacity: 0.4;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      padding: 1.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      background: linear-gradient(to bottom, var(--cream) 60%, transparent);
    }

    .nav-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      color: var(--dark);
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.3s;
    }

    .nav-links a:hover { color: var(--dark); }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 8rem 3rem 4rem;
      gap: 4rem;
      position: relative;
    }

    .hero-text { animation: fadeUp 1s ease both; }

    .hero-tag {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--brown);
      border: 1px solid var(--tan);
      padding: 0.4rem 1rem;
      border-radius: 2rem;
      margin-bottom: 2rem;
    }

    .hero-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(3.5rem, 7vw, 6rem);
      font-weight: 300;
      line-height: 1.05;
      color: var(--dark);
      margin-bottom: 1.5rem;
    }

    .hero-name em {
      font-style: italic;
      color: var(--brown);
    }

    .hero-desc {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--muted);
      max-width: 420px;
      margin-bottom: 2.5rem;
    }

    .hero-btns {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: var(--dark);
      color: var(--cream);
      padding: 0.85rem 2rem;
      border-radius: 2rem;
      text-decoration: none;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      transition: background 0.3s, transform 0.2s;
    }

    .btn-primary:hover { background: var(--brown); transform: translateY(-2px); }

    .btn-secondary {
      border: 1px solid var(--tan);
      color: var(--text);
      padding: 0.85rem 2rem;
      border-radius: 2rem;
      text-decoration: none;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      transition: border-color 0.3s, transform 0.2s;
    }

    .btn-secondary:hover { border-color: var(--brown); transform: translateY(-2px); }

    .hero-image {
      position: relative;
      animation: fadeIn 1.2s ease both 0.3s;
    }

    .hero-image img {
      width: 100%;
      max-width: 420px;
      border-radius: 2rem;
      object-fit: cover;
      aspect-ratio: 3/4;
      display: block;
      margin-left: auto;
      filter: sepia(8%);
    }

    .hero-image-frame {
      position: absolute;
      inset: -12px;
      border: 1px solid var(--tan);
      border-radius: 2.5rem;
      pointer-events: none;
    }

    .hero-float {
      position: absolute;
      bottom: 2rem;
      left: -1.5rem;
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 1rem;
      padding: 1rem 1.5rem;
      font-size: 0.8rem;
      color: var(--muted);
      box-shadow: 0 8px 32px rgba(44,24,16,0.08);
    }

    .hero-float strong { display: block; color: var(--dark); font-size: 1rem; margin-bottom: 0.2rem; }

    /* ABOUT */
    .about {
      background: var(--warm-white);
      padding: 6rem 3rem;
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 5rem;
      align-items: start;
    }

    .section-label {
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--brown);
      margin-bottom: 1rem;
    }

    .about-heading {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem;
      font-weight: 300;
      line-height: 1.2;
      color: var(--dark);
      position: sticky;
      top: 8rem;
    }

    .about-body p {
      font-size: 1rem;
      line-height: 1.9;
      color: var(--muted);
      margin-bottom: 1.5rem;
    }

    .about-body p strong { color: var(--dark); font-weight: 500; }

    .about-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 1px solid var(--sand);
    }

    .stat-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.5rem;
      font-weight: 300;
      color: var(--brown);
      display: block;
    }

    .stat-label {
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      color: var(--muted);
      text-transform: uppercase;
    }

    /* WORK */
    .work {
      padding: 6rem 3rem;
    }

    .work-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 3rem;
    }

    .work-heading {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem;
      font-weight: 300;
      color: var(--dark);
    }

    .work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .work-card {
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 1.5rem;
      padding: 2rem;
      text-decoration: none;
      color: inherit;
      transition: transform 0.3s, box-shadow 0.3s;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .work-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 48px rgba(44,24,16,0.1);
    }

    .work-icon {
      width: 48px; height: 48px;
      border-radius: 1rem;
      background: var(--sand);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }

    .work-card-tag {
      font-size: 0.68rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--brown);
    }

    .work-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--dark);
    }

    .work-card p {
      font-size: 0.88rem;
      line-height: 1.7;
      color: var(--muted);
      flex: 1;
    }

    .work-card-link {
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brown);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* PLATFORMS */
    .platforms {
      background: var(--dark);
      padding: 6rem 3rem;
      color: var(--cream);
    }

    .platforms-heading {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem;
      font-weight: 300;
      margin-bottom: 3rem;
      color: var(--cream);
    }

    .platforms-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    .platform-card {
      border: 1px solid rgba(201,185,154,0.2);
      border-radius: 1.5rem;
      padding: 2rem;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.3s, background 0.3s;
    }

    .platform-card:hover {
      border-color: var(--tan);
      background: rgba(201,185,154,0.05);
    }

    .platform-emoji { font-size: 2rem; margin-bottom: 1rem; display: block; }

    .platform-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 400;
      color: var(--cream);
      margin-bottom: 0.5rem;
    }

    .platform-card p {
      font-size: 0.82rem;
      line-height: 1.7;
      color: var(--tan);
    }

    /* CONTACT */
    .contact {
      padding: 8rem 3rem;
      text-align: center;
      background: var(--warm-white);
    }

    .contact-heading {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.5rem, 6vw, 5rem);
      font-weight: 300;
      color: var(--dark);
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }

    .contact-heading em { font-style: italic; color: var(--brown); }

    .contact p {
      color: var(--muted);
      font-size: 1rem;
      margin-bottom: 3rem;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.8rem;
      border: 1px solid var(--tan);
      border-radius: 2rem;
      text-decoration: none;
      color: var(--text);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      transition: all 0.3s;
    }

    .contact-link:hover {
      background: var(--dark);
      color: var(--cream);
      border-color: var(--dark);
      transform: translateY(-2px);
    }

    /* FOOTER */
    footer {
      background: var(--dark);
      color: var(--tan);
      text-align: center;
      padding: 2rem;
      font-size: 0.8rem;
      letter-spacing: 0.05em;
    }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* MOBILE */
    @media (max-width: 768px) {
      nav { padding: 1.2rem 1.5rem; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; padding: 7rem 1.5rem 3rem; gap: 2rem; }
      .hero-image { order: -1; }
      .hero-image img { max-width: 100%; aspect-ratio: 4/3; }
      .hero-float { left: 0; bottom: -1rem; }
      .about { grid-template-columns: 1fr; padding: 4rem 1.5rem; gap: 2rem; }
      .about-heading { position: static; font-size: 2.2rem; }
      .about-stats { grid-template-columns: repeat(3, 1fr); }
      .work { padding: 4rem 1.5rem; }
      .work-grid { grid-template-columns: 1fr; }
      .work-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .platforms { padding: 4rem 1.5rem; }
      .platforms-grid { grid-template-columns: 1fr 1fr; }
      .contact { padding: 4rem 1.5rem; }
    }
  </style>
</head>
